# Base URL of the Express API.
#
# Leave unset for local development: the app derives your machine's LAN
# address from the Expo dev server, which is what a phone or emulator can
# actually reach ("localhost" on a device means the device itself).
#
# Set it explicitly when pointing at a deployed backend:
# EXPO_PUBLIC_API_URL=https://api.your-domain.com

# EXPO_PUBLIC_API_URL=

# NOTE: anything prefixed EXPO_PUBLIC_ is embedded in the app bundle and is
# readable by anyone who installs it. Never put the JWT secret, the MongoDB
# URI, ML service credentials or LLM API keys here.
