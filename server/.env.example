# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/ups_logistics

# JWT
JWT_SECRET=replace_this_with_a_strong_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ML Recommendation Service (Python / FastAPI)
ML_SERVICE_URL=http://localhost:8000

# LLM (future)
LLM_API_KEY=
LLM_API_URL=
# CORS - comma-separated list of allowed origins.
# 5173 = Vite web client. 8081/8090 = Expo web preview for the mobile app
# (a real device or emulator does not enforce CORS, so those are dev-only).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://localhost:8090
