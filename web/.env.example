# Base URL of the Express API. The browser talks to this and nothing else.
# Leave empty in development to use the Vite dev-server proxy (/api -> :5000).
VITE_API_URL=

# Production example:
# VITE_API_URL=https://api.your-domain.com

# NOTE: only PUBLIC values belong in this file. Never put the JWT secret,
# MongoDB URI, ML service credentials or LLM API keys in a VITE_ variable -
# everything prefixed VITE_ is embedded in the JavaScript bundle and is
# readable by anyone who opens the site.
